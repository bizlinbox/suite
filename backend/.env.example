NODE_ENV=production
PORT=4000

# Database credentials (change in production)
POSTGRES_USER=bizlinbox
POSTGRES_PASSWORD=bizlinbox
POSTGRES_DB=bizlinbox
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-256-bit-random-string
JWT_REFRESH_SECRET=change-me-to-another-256-bit-random-string
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=custom-verify-token
# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=uploads
