# Backend
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://bizlinbox:bizlinbox@localhost:5432/bizlinbox
REDIS_URL=redis://localhost:6379

# Auth secrets (generate strong random values in production; minimum 32 characters)
JWT_SECRET=change-me-to-a-256-bit-random-string
JWT_REFRESH_SECRET=change-me-to-another-256-bit-random-string
ENCRYPTION_KEY=change-me-to-a-32-character-encryption-key

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v20.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# Optional: fallback global verify token for legacy webhook endpoint.
# Each WABA now auto-generates its own verify token on creation.

# Storage (use absolute path in Docker, relative for local dev)
UPLOAD_DIR=uploads

# Domain & Traefik
DOMAIN=bizinbox.bizlin.tech
LETSENCRYPT_EMAIL=admin@bizinbox.bizlin.tech

# Notifications
GOOGLE_CHAT_NOTIFICATIONS_ENABLED=false
GOOGLE_CHAT_WEBHOOK_URL=

# Frontend runtime config (optional: leave empty for same-origin API calls)
NEXT_PUBLIC_API_URL=
