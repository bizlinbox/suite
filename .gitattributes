# Auto detect text files and normalize line endings to LF on checkout
* text=auto

# Force LF for shell scripts and Docker files
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf
*.json text eol=lf

# Force LF for web source files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf